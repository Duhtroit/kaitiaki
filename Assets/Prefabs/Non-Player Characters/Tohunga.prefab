  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::npc
  npcName: Tohunga
  lines:
  - text: Haumia has decided to bless your plants by giving them a boost in growth!
    onSaid: {fileID: 11400000, guid: 20edf929a5454404cb24474e4fef0a23, type: 2}
  - text: "Kia ora \u0113 hoa!"
    onSaid: {fileID: 0}
  - text: "T\u0101whirim\u0101tea grants you rain..."
    onSaid: {fileID: 11400000, guid: f6f7abd518b4c4789a85b8d87c807a21, type: 2}
  - text: "Kei te p\u0113hea koe?"
    onSaid: {fileID: 0}
  - text: Haumia has granted you a seed, go find it!
    onSaid: {fileID: 11400000, guid: 5d48bc46f17aa4608a6718318c2333af, type: 2}
  dialoguePanel: {fileID: 4369661210067891618}
  dialogueText: {fileID: 7891180319802354030}
  nameText: {fileID: 4157526954515114370}
  showSeconds: 3
